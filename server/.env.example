# Copy to server/.env and adjust
PORT=5000
NODE_ENV=development

# Local mongo, or an Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/bugbakery

# Change this. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Origins allowed to call the API and open a socket
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Public base url of this server, used to build media urls
PUBLIC_URL=http://localhost:5000

# Seeded admin account (npm run seed)
ADMIN_EMAIL=admin@bugbakery.local
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Elie

# ---------------------------------------------------------------------------
# Automatic review
#
# The reviewer is one rung of a ladder, never the whole of it: deterministic
# checks run before it, and you can overrule it after. Pick a provider:
#
#   off               no automatic review. Checks still run; everything with a
#                     rubric goes to the review queue.
#   ollama            free, local, nothing leaves your machine. Install with
#                     `brew install ollama`, then `ollama pull qwen2.5-coder:7b`.
#   claude            best quality. Needs ANTHROPIC_API_KEY.
#   openai-compatible anything speaking /chat/completions — Groq and OpenRouter
#                     both have free tiers. Needs AI_BASE_URL and AI_API_KEY.
AI_PROVIDER=off

# Defaults per provider: claude -> claude-opus-5, ollama -> qwen2.5-coder:7b
# AI_MODEL=claude-opus-5

# claude only. Your key, or sign in once with `ant auth login`.
# ANTHROPIC_API_KEY=

# ollama / openai-compatible only.
# AI_BASE_URL=http://127.0.0.1:11434
# AI_API_KEY=

# claude only: low | medium | high | xhigh | max. Unset uses the API default.
# AI_EFFORT=

# Set to "object" for hosts that reject a json_schema response format.
# AI_JSON_MODE=schema
# AI_TIMEOUT_MS=90000

# ---------------------------------------------------------------------------
# The escalation ladder — the dials on how much work reaches a person.
#
# Below this confidence, the reviewer's verdict is not trusted and a human
# decides instead. Raise it to see more, lower it to see less.
REVIEW_CONFIDENCE_FLOOR=0.7

# Failures on the same step before it goes to a person. Someone stuck is where
# a human adds the most, so this should stay low.
REVIEW_REPEAT_FAILURES=2

# Share of auto-passed work spot-checked anyway, to catch the reviewer drifting.
REVIEW_AUDIT_RATE=0.07

# Peer reviews that must agree before a submission settles without you.
REVIEW_PEER_REQUIRED=2

# How long a trainee waits for the automatic reply before a person takes over.
# Deterministic checks always come back instantly; this is the ceiling on the
# written review only.
REVIEW_WAIT_MS=60000

# Blocked paste attempts, or pasted characters, that flag a submission for a
# person. The submission is never marked wrong on this alone — it is
# circumstantial, and a trainee pasting their own code looks the same.
REVIEW_PASTE_ATTEMPTS=2
REVIEW_PASTED_CHARACTERS=200
