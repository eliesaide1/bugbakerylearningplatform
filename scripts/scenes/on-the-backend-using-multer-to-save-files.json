{
  "title": "Where an uploaded file actually goes",
  "elements": [
    { "type": "box", "at": 0.3, "in": 0.4, "x": 60, "y": 165, "w": 250, "h": 104,
      "label": "<input type=file>", "sub": "the browser picks it", "colour": "blue" },
    { "type": "box", "at": 0.8, "in": 0.4, "x": 350, "y": 165, "w": 250, "h": 104,
      "label": "FormData", "sub": "multipart, not JSON", "colour": "blue" },
    { "type": "box", "at": 1.3, "in": 0.4, "x": 640, "y": 165, "w": 250, "h": 104,
      "label": "multer", "sub": "parses it → req.file", "colour": "green" },
    { "type": "box", "at": 1.8, "in": 0.4, "x": 930, "y": 165, "w": 250, "h": 104,
      "label": "uploads/images/", "sub": "the bytes, on disk", "colour": "purple" },

    { "type": "arrow", "at": 2.3, "in": 0.3, "from": [314, 217], "to": [346, 217], "colour": "muted" },
    { "type": "arrow", "at": 2.5, "in": 0.3, "from": [604, 217], "to": [636, 217], "colour": "muted" },
    { "type": "arrow", "at": 2.7, "in": 0.3, "from": [894, 217], "to": [926, 217], "colour": "muted" },

    { "type": "box", "at": 3.2, "in": 0.5, "x": 60, "y": 310, "w": 1120, "h": 84,
      "label": "the document stores req.file.path — a string",
      "sub": "never the bytes: documents cap at 16MB and every query would drag them along", "colour": "accent" },

    { "type": "box", "at": 4.0, "in": 0.5, "x": 60, "y": 418, "w": 1120, "h": 84,
      "label": "app.use('/uploads/images', express.static(...))",
      "sub": "without this the path is stored and the image 404s", "colour": "green" },

    { "type": "box", "at": 4.8, "in": 0.5, "x": 60, "y": 526, "w": 1120, "h": 84,
      "label": "express.json() does not parse multipart",
      "sub": "the other fields arrive as req.body only because multer put them there", "colour": "accent" },

    { "type": "caption", "at": 5.5, "text": "local disk is ephemeral on most hosts — section 13 moves this to object storage" }
  ]
}
