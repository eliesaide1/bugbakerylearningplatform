{
  "title": "CORS: the browser asks first",
  "elements": [
    { "type": "box", "at": 0.3, "in": 0.4, "x": 60, "y": 150, "w": 300, "h": 100,
      "label": "localhost:3000", "sub": "the React app", "colour": "blue" },
    { "type": "box", "at": 0.6, "in": 0.4, "x": 920, "y": 150, "w": 300, "h": 100,
      "label": "localhost:5000", "sub": "the API — a different origin", "colour": "green" },

    { "type": "box", "at": 1.3, "in": 0.4, "x": 400, "y": 150, "w": 480, "h": 46,
      "label": "OPTIONS  — may I?", "colour": "muted" },
    { "type": "arrow", "at": 1.6, "in": 0.4, "from": [364, 173], "to": [396, 173], "colour": "muted" },
    { "type": "arrow", "at": 1.8, "in": 0.4, "from": [884, 173], "to": [916, 173], "colour": "muted" },

    { "type": "box", "at": 2.2, "in": 0.4, "x": 400, "y": 208, "w": 480, "h": 46,
      "label": "Access-Control-Allow-*  — yes", "colour": "accent" },
    { "type": "arrow", "at": 2.5, "in": 0.4, "from": [916, 231], "to": [884, 231], "colour": "accent" },
    { "type": "arrow", "at": 2.7, "in": 0.4, "from": [396, 231], "to": [364, 231], "colour": "accent" },

    { "type": "box", "at": 3.3, "in": 0.5, "x": 400, "y": 300, "w": 480, "h": 60,
      "label": "only then: the real POST", "colour": "green" },

    { "type": "box", "at": 4.0, "in": 0.5, "x": 60, "y": 400, "w": 1160, "h": 96,
      "label": "the preflight is a request your middleware must answer",
      "sub": "it carries no body and no auth header — so a route that requires either will reject it", "colour": "purple" },

    { "type": "box", "at": 4.8, "in": 0.5, "x": 60, "y": 516, "w": 1160, "h": 86,
      "label": "CORS is enforced by the browser, not by the server",
      "sub": "curl and Postman never see it — which is why it is not a security boundary", "colour": "accent" },

    { "type": "caption", "at": 5.5, "text": "the server was reached and answered; the browser refused to hand you the result" }
  ]
